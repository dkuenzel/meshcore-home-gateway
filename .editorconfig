root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,toml,json}]
indent_size = 2

[*.sh]
indent_size = 2

# the firmware tests' board and shims, in the style of the MeshCore firmware they build with
[*.{h,hpp,cpp}]
indent_size = 2

[Makefile]
indent_style = tab
