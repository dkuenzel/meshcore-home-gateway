{
  "name": "main",
  "target": "branch",
  "source_type": "Repository",
  "source": "dkuenzel/meshcore-home-gateway",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "~DEFAULT_BRANCH"
      ]
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "required_reviewers": [],
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false,
        "require_extra_approval_for_unattributed_changes": true,
        "allowed_merge_methods": [
          "squash"
        ]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "test (Python 3.11)",
            "integration_id": 15368
          },
          {
            "context": "test (Python 3.12)",
            "integration_id": 15368
          },
          {
            "context": "test (Python 3.13)",
            "integration_id": 15368
          },
          {
            "context": "test (Python 3.14)",
            "integration_id": 15368
          },
          {
            "context": "Home Assistant contract",
            "integration_id": 15368
          },
          {
            "context": "real firmware on a simulated air",
            "integration_id": 15368
          },
          {
            "context": "lint, shellcheck, workflow audit, build, unit check",
            "integration_id": 15368
          },
          {
            "context": "release plan",
            "integration_id": 15368
          }
        ]
      }
    }
  ],
  "bypass_actors": [
    {
      "actor_id": 2,
      "actor_type": "RepositoryRole",
      "bypass_mode": "always"
    }
  ]
}
