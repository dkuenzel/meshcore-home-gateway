#, python-brace-format
msgid "'{tool}' not found: this must run on a Proxmox VE host"
msgstr "'{tool}' nicht gefunden: Das muss auf einem Proxmox-VE-Host laufen"

msgid "--answers needs a file"
msgstr "--answers braucht eine Datei"

#, python-brace-format
msgid "--reconfigure cannot apply the answer {key} (see docs/deployment.md)"
msgstr "--reconfigure kann die Antwort {key} nicht anwenden (siehe docs/deployment.md)"

msgid "--reconfigure needs a container ID"
msgstr "--reconfigure braucht eine Container-ID"

msgid "--ref needs a branch, tag or commit, e.g. main"
msgstr "--ref braucht einen Branch, ein Tag oder einen Commit, z. B. main"

msgid "--release and --ref exclude each other"
msgstr "--release und --ref schließen sich gegenseitig aus"

msgid "--release needs a version, e.g. 0.1.0"
msgstr "--release braucht eine Version, z. B. 0.1.0"

msgid "--update needs a container ID"
msgstr "--update braucht eine Container-ID"

msgid "Announce the radio to Home Assistant (MQTT discovery)?"
msgstr "Das Funkgerät bei Home Assistant anmelden (MQTT-Erkennung)?"

msgid "At its next connect the service sets the radio:"
msgstr "Beim nächsten Verbinden setzt der Dienst am Funkgerät:"

msgid "Base topic"
msgstr "Basis-Topic"

msgid "Channels to send to"
msgstr "Kanäle, an die gesendet wird"

msgid "Command words, comma-separated (e.g. status,arm,disarm)"
msgstr "Befehlswörter, durch Kommas getrennt (z. B. status,arm,disarm)"

msgid "Contacts allowed to send commands (direct messages only)"
msgstr "Kontakte, die Befehle senden dürfen (nur Direktnachrichten)"

msgid "Contacts to send to"
msgstr "Kontakte, an die gesendet wird"

msgid "Container ID"
msgstr "Container-ID"

msgid "Container host name"
msgstr "Hostname des Containers"

#. security text (docs/translations.md): the values start in one column; {tls} is
#. true or false.
#, python-brace-format
msgid ""
"Create container {id} ({hostname}) now?\n"
"\n"
"Disk:     {storage}, {disk} GB\n"
"Memory:   {memory} MB\n"
"Network:  {network}\n"
"Radio:    {radio}\n"
"Broker:   {host}:{port}, TLS {tls}\n"
"Login:    {login}\n"
"\n"
"Afterwards the channels and contacts are read from the radio."
msgstr ""
"Container {id} ({hostname}) jetzt erstellen?\n"
"\n"
"Datenträger:      {storage}, {disk} GB\n"
"Arbeitsspeicher:  {memory} MB\n"
"Netzwerk:         {network}\n"
"Funkgerät:        {radio}\n"
"Broker:           {host}:{port}, TLS {tls}\n"
"Anmeldung:        {login}\n"
"\n"
"Danach werden die Kanäle und Kontakte vom Funkgerät gelesen."

msgid "Device name in Home Assistant"
msgstr "Gerätename in Home Assistant"

msgid "Disk size in GB"
msgstr "Größe des Datenträgers in GB"

#. {message} is one of the errors, translated too.
#, python-brace-format
msgid "Error: {message}"
msgstr "Fehler: {message}"

#, python-brace-format
msgid "ID {id} is already used by a container or virtual machine"
msgstr "ID {id} wird schon von einem Container oder einer virtuellen Maschine verwendet"

msgid "IPv4 address with prefix (e.g. 192.0.2.20/24), or dhcp"
msgstr "IPv4-Adresse mit Präfix (z. B. 192.0.2.20/24) oder dhcp"

msgid "IPv4 gateway"
msgstr "IPv4-Gateway"

msgid "Language of the names in Home Assistant"
msgstr "Sprache der Namen in Home Assistant"

msgid "MQTT broker port"
msgstr "Port des MQTT-Brokers"

msgid "MQTT broker: host name or IP address (no mqtt://)"
msgstr "MQTT-Broker: Hostname oder IP-Adresse (ohne mqtt://)"

#, python-brace-format
msgid "MQTT user name as set up on the broker (it was '{was}'); empty: none"
msgstr "MQTT-Benutzername, wie auf dem Broker eingerichtet (bisher '{was}'); leer: keiner"

msgid "MQTT user name as set up on the broker, e.g. meshcore-home-gateway (empty: none)"
msgstr "MQTT-Benutzername, wie auf dem Broker eingerichtet, z. B. meshcore-home-gateway (leer: keiner)"

msgid "MQTT user name as set up on the broker; empty: none"
msgstr "MQTT-Benutzername, wie auf dem Broker eingerichtet; leer: keiner"

msgid "Memory in MB"
msgstr "Arbeitsspeicher in MB"

msgid "Name of the radio in the mesh (1-31 bytes; empty: keep the radio's)"
msgstr "Name des Funkgeräts im Mesh (1-31 Bytes; leer: den des Funkgeräts behalten)"

msgid "Network bridge"
msgstr "Netzwerk-Bridge"

#. security text (docs/translations.md): translate all of it, add nothing.
msgid "No user name: unless the broker refuses clients without one, anyone who reaches it can read the messages and the positions and send commands to the gateway. Continue without a user name?"
msgstr "Kein Benutzername: Sofern der Broker Clients ohne Benutzernamen nicht abweist, können alle, die ihn erreichen, die Nachrichten und die Positionen lesen und dem Gateway Befehle senden. Ohne Benutzernamen fortfahren?"

msgid "Node id (in topics and entity IDs)"
msgstr "Knoten-ID (in Topics und Entitäts-IDs)"

#. security text (docs/translations.md): asks for the broker's password.
#, python-brace-format
msgid "Password of MQTT user '{user}' (empty: keep the current one)"
msgstr "Passwort des MQTT-Benutzers '{user}' (leer: das aktuelle behalten)"

#. security text (docs/translations.md): asks for the broker's password.
#, python-brace-format
msgid "Password of MQTT user '{user}' (empty: keep the installed one)"
msgstr "Passwort des MQTT-Benutzers '{user}' (leer: das installierte behalten)"

#. security text (docs/translations.md): asks for the broker's password.
#, python-brace-format
msgid "Password of MQTT user '{user}' (empty: none)"
msgstr "Passwort des MQTT-Benutzers '{user}' (leer: keins)"

#, python-brace-format
msgid "Proxmox VE {version} is too old: 8 with current updates, or 9, is needed"
msgstr "Proxmox VE {version} ist zu alt: Nötig ist 8 mit aktuellen Updates oder 9"

msgid "Radio TCP port"
msgstr "TCP-Port des Funkgeräts"

msgid "Radio address (host name or IP address)"
msgstr "Adresse des Funkgeräts (Hostname oder IP-Adresse)"

msgid "Radio connection"
msgstr "Verbindung zum Funkgerät"

msgid "Send ASCII only (for handhelds without Unicode fonts)?"
msgstr "Nur ASCII senden (für Handgeräte ohne Unicode-Schriften)?"

msgid "Setup"
msgstr "Einrichtung"

msgid "Storage for templates"
msgstr "Speicher für Vorlagen"

msgid "Storage for the container disk"
msgstr "Speicher für den Datenträger des Containers"

#. security text (docs/translations.md).
msgid "TLS, no user name"
msgstr "TLS, kein Benutzername"

#. security text (docs/translations.md).
#, python-brace-format
msgid "TLS, user '{user}'"
msgstr "TLS, Benutzer '{user}'"

#. security text (docs/translations.md): translate all of it, add nothing.
#. {what} is "no user name" or "no TLS".
#, python-brace-format
msgid "The broker connection has {what}: any client that reaches the broker could publish command events as if an allowed contact had sent them. Accept it (insecure = true)? No: no commands."
msgstr "Die Verbindung zum Broker hat {what}: Jeder Client, der den Broker erreicht, könnte Befehlsereignisse veröffentlichen, als hätte ein erlaubter Kontakt sie gesendet. Akzeptieren (insecure = true)? Nein: keine Befehle."

#. {reason} is the program's message, in this language too.
#, python-brace-format
msgid ""
"The broker login failed:\n"
"\n"
"{reason}\n"
"\n"
"Enter the broker settings again? (No: continue; the service keeps trying, --reconfigure fixes the settings later.)"
msgstr ""
"Die Anmeldung am Broker ist fehlgeschlagen:\n"
"\n"
"{reason}\n"
"\n"
"Die Broker-Einstellungen erneut eingeben? (Nein: weiter; der Dienst versucht es weiter, --reconfigure korrigiert die Einstellungen später.)"

#. {reason} is the program's message, in this language too.
#, python-brace-format
msgid ""
"The broker settings were not accepted:\n"
"\n"
"{reason}"
msgstr ""
"Die Broker-Einstellungen wurden nicht akzeptiert:\n"
"\n"
"{reason}"

#, python-brace-format
msgid ""
"The container starts only while the radio is plugged in.\n"
"After re-plugging the radio: {command}"
msgstr ""
"Der Container startet nur, solange das Funkgerät eingesteckt ist.\n"
"Nach erneutem Einstecken des Funkgeräts: {command}"

#. security text (docs/translations.md): translate all of it, add nothing.
#, python-brace-format
msgid "The radio is reached over TCP ({address}) without authentication: whoever reaches it can control it and read its private key."
msgstr "Das Funkgerät wird über TCP ({address}) ohne Authentifizierung erreicht: Wer es erreicht, kann es steuern und seinen privaten Schlüssel lesen."

#. security text (docs/translations.md): translate all of it, add nothing.
msgid "The radio's TCP interface has no authentication: anyone who reaches it can control the radio and read its private key, which decrypts every direct message of the radio, also earlier ones recorded from the air. Use it only in a network that only the gateway reaches, never the household's WiFi. Use TCP anyway (tcp_unauthenticated = true)? No: choose the radio again."
msgstr "Die TCP-Schnittstelle des Funkgeräts hat keine Authentifizierung: Wer sie erreicht, kann das Funkgerät steuern und seinen privaten Schlüssel lesen, der jede Direktnachricht des Funkgeräts entschlüsselt, auch frühere, die über Funk mitgeschnitten wurden. Nutze sie nur in einem Netzwerk, das nur das Gateway erreicht, nie im WLAN des Haushalts. TCP trotzdem verwenden (tcp_unauthenticated = true)? Nein: Funkgerät erneut wählen."

msgid ""
"The radio's firmware is not tested: the service only reports what differs\n"
"(radio.profile.manage = always sets it anyway):"
msgstr ""
"Die Firmware des Funkgeräts ist nicht getestet: Der Dienst meldet nur, was abweicht\n"
"(radio.profile.manage = always setzt es trotzdem):"

msgid "The service leaves alone:"
msgstr "Der Dienst lässt unverändert:"

#. security text (docs/translations.md): translate all of it, add nothing.
msgid "Use TLS for the broker connection? Without it the password, the messages, the positions and the commands cross the network in the clear."
msgstr "TLS für die Verbindung zum Broker verwenden? Ohne TLS gehen das Passwort, die Nachrichten, die Positionen und die Befehle unverschlüsselt durch das Netzwerk."

msgid "With radio.profile.manage = observe the service only reports what differs:"
msgstr "Mit radio.profile.manage = observe meldet der Dienst nur, was abweicht:"

msgid "a radio over TCP needs radio.tcp_unauthenticated = true; for USB, install a new container"
msgstr "ein Funkgerät über TCP braucht radio.tcp_unauthenticated = true; für USB installiere einen neuen Container"

msgid "all settings: container, network, topics, Home Assistant"
msgstr "alle Einstellungen: Container, Netzwerk, Topics, Home Assistant"

