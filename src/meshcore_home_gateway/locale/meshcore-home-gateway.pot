#: src/meshcore_home_gateway/mqtt/discovery.py
msgctxt "home assistant"
msgid "Contact with remote access"
msgstr ""

#. sensor of the gateway: the number of contacts on its radio
#: src/meshcore_home_gateway/mqtt/discovery.py
msgctxt "home assistant"
msgid "Contacts"
msgstr ""

#. event entity of the gateway: how far a message it sent has come
#. (queued, sent, confirmed, failed)
#: src/meshcore_home_gateway/mqtt/discovery.py
msgctxt "home assistant"
msgid "Delivery"
msgstr ""

#. sensor (signal strength) of the gateway: the received signal strength
#. (RSSI) of the last packet its radio heard
#: src/meshcore_home_gateway/mqtt/discovery.py
msgctxt "home assistant"
msgid "Last packet RSSI"
msgstr ""

#. sensor (signal strength) of the gateway: the signal-to-noise ratio
#. (SNR) of the last packet its radio heard
#: src/meshcore_home_gateway/mqtt/discovery.py
msgctxt "home assistant"
msgid "Last packet SNR"
msgstr ""

#. binary sensor (problem) of the gateway: on while it hears a node
#. whose key begins like a protected contact's, which may pose as that contact
#: src/meshcore_home_gateway/mqtt/discovery.py
msgctxt "home assistant"
msgid "Look-alike node heard"
msgstr ""

#. the default name of the gateway's device in Home Assistant; MeshCore is the
#. name of the mesh firmware
#: src/meshcore_home_gateway/mqtt/discovery.py
msgctxt "home assistant"
msgid "MeshCore radio"
msgstr ""

#. event entity of the gateway: its radio heard a node for the first
#. time
#: src/meshcore_home_gateway/mqtt/discovery.py
msgctxt "home assistant"
msgid "New node"
msgstr ""

#. sensor of the gateway: the number of nodes its radio heard lately
#. (node: any MeshCore station)
#: src/meshcore_home_gateway/mqtt/discovery.py
msgctxt "home assistant"
msgid "Nodes heard"
msgstr ""

#. sensor (signal strength) of the gateway: the noise its radio hears
#. when nobody transmits
#: src/meshcore_home_gateway/mqtt/discovery.py
msgctxt "home assistant"
msgid "Noise floor"
msgstr ""

#. sensor of the gateway: a counter of the packets its radio received
#: src/meshcore_home_gateway/mqtt/discovery.py
msgctxt "home assistant"
msgid "Packets received"
msgstr ""

#. sensor of the gateway: a counter of the packets its radio sent
#: src/meshcore_home_gateway/mqtt/discovery.py
msgctxt "home assistant"
msgid "Packets sent"
msgstr ""

#. sensor of the gateway: the messages waiting to be sent
#: src/meshcore_home_gateway/mqtt/discovery.py
msgctxt "home assistant"
msgid "Queue"
msgstr ""

#. binary sensor (connectivity) of the gateway: its USB or TCP link to
#. its own radio, not a link over the air. Home Assistant shows the device name first.
#: src/meshcore_home_gateway/mqtt/discovery.py
msgctxt "home assistant"
msgid "Radio link"
msgstr ""

#. sensor (enum) of the gateway: whether its radio's settings match the
#. profile the gateway keeps on it
#: src/meshcore_home_gateway/mqtt/discovery.py
msgctxt "home assistant"
msgid "Radio profile"
msgstr ""

#. event entity of the gateway: it wrote a setting of the profile to its
#. radio, or could not
#: src/meshcore_home_gateway/mqtt/discovery.py
msgctxt "home assistant"
msgid "Radio setting"
msgstr ""

#. sensor (duration) of the gateway: what its radio itself counted as
#. sent in the last hour, adverts and acknowledgements included
#: src/meshcore_home_gateway/mqtt/discovery.py
msgctxt "home assistant"
msgid "Radio transmit time last hour"
msgstr ""

#. sensor (duration) of the gateway: the time since its radio started
#: src/meshcore_home_gateway/mqtt/discovery.py
msgctxt "home assistant"
msgid "Radio uptime"
msgstr ""

#. sensor of the gateway: a counter of the packets its radio could not
#. read
#: src/meshcore_home_gateway/mqtt/discovery.py
msgctxt "home assistant"
msgid "Receive errors"
msgstr ""

#. the name of an entity that exists only for a moment, while the gateway
#. removes it from Home Assistant
#: src/meshcore_home_gateway/mqtt/discovery.py
msgctxt "home assistant"
msgid "Removed"
msgstr ""

#. notify entity of the gateway: sends a message to a target of the
#. configuration; {alias} is the target's name there, as the user wrote it
#: src/meshcore_home_gateway/mqtt/discovery.py
#, python-brace-format
msgctxt "home assistant"
msgid "Send to {alias}"
msgstr ""

#. button of the gateway: brings back the contacts' devices the user
#. deleted in Home Assistant
#: src/meshcore_home_gateway/mqtt/discovery.py
msgctxt "home assistant"
msgid "Show hidden contacts"
msgstr ""

#. sensor (duration) of the gateway: its own transmit time for
#. telemetry requests in the last hour
#: src/meshcore_home_gateway/mqtt/discovery.py
msgctxt "home assistant"
msgid "Telemetry airtime last hour"
msgstr ""

#. sensor (duration) of the gateway: the airtime its telemetry requests
#. caused in the whole mesh in the last hour, as estimated
#: src/meshcore_home_gateway/mqtt/discovery.py
msgctxt "home assistant"
msgid "Telemetry mesh airtime last hour"
msgstr ""

#. sensor (enum) of the gateway: whether it asks the household's
#. companions for telemetry; keep it apart from "Telemetry state" of a contact
#: src/meshcore_home_gateway/mqtt/discovery.py
msgctxt "home assistant"
msgid "Telemetry status"
msgstr ""

#. text entity of the gateway: a node's public key or a contact link
#. typed or pasted here adds that node as a contact
#: src/meshcore_home_gateway/mqtt/manage_entities.py
msgctxt "home assistant"
msgid "Add contact (key or link)"
msgstr ""

#. select of the gateway: choosing one of the nodes its radio heard adds
