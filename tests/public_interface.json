 "format": 1,
 "homeassistant": {
  "components": {
   "contact": {
    "advert_position": {
     "device_class": "problem",
     "entity_id": "binary_sensor.mesh_<slug>_advert_position",
     "node_types": [
      "chat"
     ],
     "platform": "binary_sensor"
    },
    "battery": {
     "device_class": "voltage",
     "entity_id": "sensor.mesh_<slug>_battery",
     "node_types": [
      "chat"
     ],
     "platform": "sensor",
     "state_class": "measurement",
     "unit": "V"
    },
    "ch1_luminosity": {
     "entity_id": "sensor.mesh_<slug>_ch1_luminosity",
     "node_types": [
      "chat"
     ],
     "platform": "sensor",
     "state_class": "measurement"
    },
    "ch1_temperature": {
     "device_class": "temperature",
     "entity_id": "sensor.mesh_<slug>_ch1_temperature",
     "node_types": [
      "chat"
     ],
     "platform": "sensor",
     "state_class": "measurement",
     "unit": "°C"
    },
    "ch2_altitude": {
     "device_class": "distance",
     "entity_id": "sensor.mesh_<slug>_ch2_altitude",
     "node_types": [
      "chat"
     ],
     "platform": "sensor",
     "state_class": "measurement",
     "unit": "m"
    },
    "ch2_analog_input": {
     "entity_id": "sensor.mesh_<slug>_ch2_analog_input",
     "node_types": [
      "chat"
     ],
     "platform": "sensor",
     "state_class": "measurement"
    },
    "ch2_barometric_pressure": {
     "device_class": "atmospheric_pressure",
     "entity_id": "sensor.mesh_<slug>_ch2_barometric_pressure",
     "node_types": [
      "chat"
     ],
     "platform": "sensor",
     "state_class": "measurement",
     "unit": "hPa"
    },
    "ch2_current": {
     "device_class": "current",
     "entity_id": "sensor.mesh_<slug>_ch2_current",
     "node_types": [
      "chat"
     ],
     "platform": "sensor",
     "state_class": "measurement",
     "unit": "A"
